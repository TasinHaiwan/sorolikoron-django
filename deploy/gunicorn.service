# Install: sudo cp deploy/gunicorn.service /etc/systemd/system/sorolikoron.service
[Unit]
Description=Sorolikoron Django API (gunicorn)
After=network.target postgresql.service

[Service]
User=sorolikoron
Group=www-data
WorkingDirectory=/srv/sorolikoron
ExecStart=/srv/sorolikoron/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60
Restart=always

[Install]
WantedBy=multi-user.target
